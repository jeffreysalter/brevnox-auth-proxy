{
    auto_https off
    admin off
    
    servers {
        trusted_proxies static private_ranges
        client_ip_headers X-Forwarded-For
    }
}

:10000 {
    log {
        output stdout
        format json
    }

    # Health check for Render
    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    @auth host auth.brevnox.com
    handle @auth {
        reverse_proxy logto-y7g9:3001
    }

    @admin host admin.brevnox.com
    handle @admin {
        # Allow Render's internal network (Logto's own self-calls)
        @internal_admin remote_ip private_ranges
        handle @internal_admin {
            reverse_proxy logto-y7g9:3002
        }

        # Allow your public IP(s) via Cloudflare's real-client-IP header
        @allowed_admin header Cf-Connecting-Ip 24.153.132.118
        handle @allowed_admin {
            reverse_proxy logto-y7g9:3002
        }

        handle {
            respond "Forbidden" 403
        }
    }
}
