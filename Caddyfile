{
    auto_https off
    admin off
    
    servers {
        trusted_proxies static private_ranges
        client_ip_headers X-Forwarded-For
    }
}

:10000 {
    log {
        output stdout
        format json
    }

    # Health check for Render
    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    @auth host auth.brevnox.com
    handle @auth {
        reverse_proxy logto-y7g9:3001
    }

    @admin host admin.brevnox.com
    handle @admin {
        # Block any request that has a Cf-Connecting-Ip header but it doesn't match the allowlist.
        # Requests without the header (internal Render traffic) pass through.
        @blocked {
            not header Cf-Connecting-Ip 24.153.132.118
            header Cf-Connecting-Ip *
        }
        handle @blocked {
            respond "Forbidden" 403
        }
        
        reverse_proxy logto-y7g9:3002
    }
}
