{
    auto_https off
    admin off
    
    servers {
        trusted_proxies static private_ranges
        client_ip_headers X-Forwarded-For
    }
}

:10000 {
    log {
        output stdout
        format json
    }

    # Health check for Render
    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    @auth host auth.brevnox.com
    handle @auth {
        reverse_proxy logto-y7g9:3001
    }

    @admin host admin.brevnox.com
    handle @admin {
        # Logto's self-calls come through with User-Agent: node - allow them
        @internal_self_call header User-Agent node
        handle @internal_self_call {
            reverse_proxy logto-y7g9:3002
        }
        
        # Block requests from public internet that aren't from allowlisted IP
        @blocked {
            not header Cf-Connecting-Ip 24.153.132.118
            header Cf-Connecting-Ip *
        }
        handle @blocked {
            respond "Forbidden" 403
        }
        
        # Everything else (allowlisted IP, or internal Render traffic without Cf-Connecting-Ip)
        reverse_proxy logto-y7g9:3002
    }
}
